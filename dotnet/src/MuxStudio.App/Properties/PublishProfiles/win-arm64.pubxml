<?xml version="1.0" encoding="utf-8"?>
<!--
  Ban phat hanh cho Windows on ARM (vd Snapdragon X): dotnet publish src\MuxStudio.App -c Release -p:PublishProfile=win-arm64
  (build.bat chay ca win-x64 va win-arm64). Ket qua: dotnet\dist\win-arm64\MuxStudio.exe + kiem_tra_MuxStudio.bat.
  - self-contained: may dich KHONG can cai .NET.
  - mot file: thu vien native cua WPF cung nam trong .exe (lan dau chay giai nen vao %TEMP%\.net).
  - ReadyToRun: bien dich san -> khoi dong nhanh hon (~0,72 s so voi ~0,85 s, do 13/11/2026 tren may x64).
  - KHONG nen file .exe (EnableCompressionInSingleFile): nho hon mot nua nhung khoi dong cham them ~0,2 s.
  - KHONG cat bot (PublishTrimmed): WPF khong ho tro.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\win-arm64\</PublishDir>
  </PropertyGroup>
</Project>
