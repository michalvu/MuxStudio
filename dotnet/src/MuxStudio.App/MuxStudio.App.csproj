<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MuxStudio</AssemblyName>
    <RootNamespace>MuxStudio.App</RootNamespace>
    <!-- icon cua file .exe (Explorer, thanh tac vu) -->
    <ApplicationIcon>Assets\muxstudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuxStudio.Core\MuxStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- icon cua so / thanh tieu de (AppIcon.cs) -->
    <Resource Include="Assets\muxstudio.ico" />
    <Resource Include="Assets\muxstudio.png" />
    <!-- ban phat hanh (build.bat): nam CANH MuxStudio.exe, khong nhet vao file .exe -->
    <None Include="kiem_tra_MuxStudio.bat" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
