<UserControl x:Class="MuxStudio.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:MuxStudio.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="7*" />
      </Grid.ColumnDefinitions>
      <ui:Card Grid.Column="0" Margin="0,0,12,0" Padding="18" VerticalAlignment="Stretch">
        <StackPanel>
          <Border Width="56" Height="56" Margin="0,0,0,12" HorizontalAlignment="Left" CornerRadius="10" Background="{StaticResource AmberAccentBrush}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource BadgeTextBrush}" Text="MS" />
          </Border>
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AmberTextBrush}" Text="AUTHOR" />
          <TextBlock x:Name="TitleText" Margin="0,4,0,2" FontSize="24" FontWeight="Bold" />
          <TextBlock x:Name="AuthorText" FontSize="16" FontWeight="Bold" />
          <TextBlock x:Name="CopyrightText" Margin="0,2,0,0" Style="{StaticResource Body}" />
          <TextBlock x:Name="WhatText" Margin="0,6,0,0" Style="{StaticResource Hint}" />
        </StackPanel>
      </ui:Card>
      <ui:Card Grid.Column="1" Padding="18" VerticalAlignment="Stretch">
        <DockPanel LastChildFill="True">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Copy24}" Content="{l:Tr 'Chép nội dung trang này'}" Click="Copy_Click" />
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AmberTextBrush}"
                       VerticalAlignment="Center" Text="THIRD-PARTY SOFTWARE &amp; SERVICES" />
          </DockPanel>
          <TextBlock x:Name="NoteText" Style="{StaticResource Body}" />
        </DockPanel>
      </ui:Card>
    </Grid>
    <ui:Card Grid.Row="1" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
      <DataGrid x:Name="CreditGrid" Style="{StaticResource WbGrid}" />
    </ui:Card>
    <TextBlock x:Name="AttrText" Grid.Row="2" Margin="4,8,0,0" Style="{StaticResource Hint}" />
  </Grid>
</UserControl>
