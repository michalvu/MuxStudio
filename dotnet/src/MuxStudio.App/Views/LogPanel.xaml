<UserControl x:Class="MuxStudio.App.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:MuxStudio.App">
  <Border Margin="12,0,12,6" Padding="10,6,10,8" CornerRadius="8"
          Background="{DynamicResource ControlFillColorDefaultBrush}"
          BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ui:Button x:Name="OpenBtn" Margin="4,0,0,0" Padding="10,4" Content="{l:Tr 'Mở thư mục'}" Click="OpenFolder_Click" />
          <ui:Button x:Name="SaveBtn" Margin="4,0,0,0" Padding="10,4" Content="{l:Tr 'Lưu log…'}" Click="Save_Click" />
          <ui:Button x:Name="ClearBtn" Margin="4,0,0,0" Padding="10,4" Content="{l:Tr 'Xoá'}" Click="Clear_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource IndigoAccentBrush}">
            <TextBlock Style="{StaticResource BadgeText}" Text="LOG" />
          </Border>
          <ui:Button x:Name="ToggleBtn" Appearance="Transparent" Padding="6,2" Click="Toggle_Click">
            <TextBlock x:Name="ToggleText" FontWeight="SemiBold" />
          </ui:Button>
          <TextBlock x:Name="CountText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource LogDimBrush}" />
        </StackPanel>
      </DockPanel>
      <ListBox x:Name="Box" Grid.Row="1" Margin="0,6,0,0" SelectionMode="Extended"
               FontFamily="{StaticResource MonoFont}" FontSize="12"
               Background="{DynamicResource ConsoleBgBrush}" BorderBrush="{DynamicResource ConsoleBorderBrush}" BorderThickness="1"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               KeyDown="Box_KeyDown">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{l:Tr 'Chép'}" Click="Copy_Click" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock x:Name="T" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource LogInfoBrush}" />
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Level}" Value="ok">
                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource LogOkBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Level}" Value="warn">
                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource LogWarnBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Level}" Value="error">
                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Level}" Value="dim">
                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource LogDimBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Level}" Value="head">
                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource LogHeadBrush}" />
                <Setter TargetName="T" Property="FontWeight" Value="Bold" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
