<UserControl x:Class="MuxStudio.App.Views.PrepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:MuxStudio.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 1. đếm + 2–3. mốc / ngôn ngữ -->
    <ui:Card Grid.Row="0" Padding="14,10" Margin="0,0,0,10">
      <StackPanel>
        <DockPanel Margin="0,0,0,8" LastChildFill="True">
          <ui:Button x:Name="ResetBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Content="{l:Tr '↺ Làm lại từ đầu'}" Click="Reset_Click"
                     ToolTip="{l:Tr 'Xoá mọi bảng và tiến độ của lượt này (thanh các bước về như chưa làm gì) để làm lô file mới. KHÔNG xoá file nào; Mốc đồng bộ và Ngôn ngữ đang chọn được giữ.'}" />
          <ui:Button x:Name="RecountBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}" Content="{l:Tr 'Làm mới'}" Click="Recount_Click" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource CyanAccentBrush}">
              <TextBlock Style="{StaticResource BadgeText}" Text="STEP 02 · MULTI-LANGUAGE SYNC RULE" />
            </Border>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr '② Chuẩn bị phụ đề'}" Margin="0,0,14,0" />
          </StackPanel>
        </DockPanel>
        <!-- 1. đếm: phim / phụ đề cần sync / phụ đề gốc -->
        <StackPanel x:Name="CountTiles" Orientation="Horizontal" Margin="0,0,0,10" />
        <WrapPanel Orientation="Horizontal">
          <TextBlock Margin="0,0,10,8" VerticalAlignment="Center" FontWeight="Bold" Text="{l:Tr 'Mốc đồng bộ:'}" />
          <RadioButton x:Name="ModeSub" GroupName="prepmode" Style="{StaticResource PillCyan}" IsChecked="True" Checked="Mode_Changed" />
          <RadioButton x:Name="ModeAudio" GroupName="prepmode" Style="{StaticResource PillCyan}" Margin="0,0,24,8" Checked="Mode_Changed">
            <TextBlock Text="{l:Tr 'Audio của file phim'}" />
          </RadioButton>
          <TextBlock Margin="0,0,8,8" VerticalAlignment="Center" FontWeight="Bold" Text="{l:Tr 'Ngôn ngữ:'}" />
          <ComboBox x:Name="LangBox" Width="440" Margin="0,0,0,6" DisplayMemberPath="Shown" SelectionChanged="Lang_Changed" />
        </WrapPanel>
        <TextBlock x:Name="ExtractHint" Visibility="Collapsed" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource LogWarnBrush}" />
      </StackPanel>
    </ui:Card>

    <!-- bảng audio của MỌI file phim (chỉ khi mốc = audio) -->
    <ui:Card x:Name="AudioBox" Grid.Row="1" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="AudioTitle" Style="{StaticResource Body}" Margin="0,0,0,6" />
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Bold" Text="{l:Tr 'Audio làm mốc:'}" />
          <RadioButton x:Name="AModeAuto" GroupName="amode" Style="{StaticResource PillCyan}" Checked="AMode_Checked">
            <TextBlock Text="{l:Tr 'Tự động (audio Default của file)'}" />
          </RadioButton>
          <RadioButton x:Name="AModeIndex" GroupName="amode" Style="{StaticResource PillCyan}" Checked="AMode_Checked">
            <TextBlock Text="{l:Tr 'Theo số thứ tự (chọn dòng bên dưới)'}" />
          </RadioButton>
          <RadioButton x:Name="AModeLang" GroupName="amode" Style="{StaticResource PillCyan}" Margin="0,0,6,8" Checked="AMode_Checked">
            <TextBlock Text="{l:Tr 'Theo ngôn ngữ:'}" />
          </RadioButton>
          <ui:TextBox x:Name="ALang" Width="80" Margin="0,0,0,8" TextChanged="ALang_TextChanged" />
        </WrapPanel>
        <DataGrid x:Name="AudioGrid" Style="{StaticResource WbGrid}" MaxHeight="150" />
      </StackPanel>
    </ui:Card>

    <!-- các bước -->
    <ui:Card Grid.Row="2" Padding="12,6" Margin="0,0,0,10">
      <WrapPanel x:Name="StepsPanel" Orientation="Horizontal" />
    </ui:Card>

    <!-- đổi tên / đồng bộ -->
    <TabControl x:Name="Inner" Grid.Row="3">
      <TabItem x:Name="TabRename">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="RenameInfo" Style="{StaticResource Body}" Margin="2,0,0,6" />
          <DataGrid x:Name="RenameGrid" Grid.Row="1" Style="{StaticResource WbGrid}" />
        </Grid>
      </TabItem>
      <TabItem x:Name="TabSync">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
            <ui:Button x:Name="CmdBtn" Margin="0,0,6,0" Icon="{ui:SymbolIcon Code24}" Content="{l:Tr 'Xem lệnh'}" Click="Cmd_Click" />
            <CheckBox x:Name="OnlyBad" Margin="8,0,12,0" Content="{l:Tr 'Chỉ hiện file cần xem'}" Click="OnlyBad_Click" />
            <ui:Button x:Name="ExportBtn" Margin="0,0,10,0" Icon="{ui:SymbolIcon DocumentTable24}" Content="{l:Tr 'Xuất CSV…'}" Click="Export_Click" />
            <WrapPanel x:Name="SyncInfo" Orientation="Horizontal" VerticalAlignment="Center" />
          </WrapPanel>
          <DataGrid x:Name="SyncGrid" Grid.Row="1" Style="{StaticResource WbGrid}" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
