<UserControl x:Class="MuxStudio.App.Views.MuxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:MuxStudio.App">
  <UserControl.Resources>
    <!-- Thẻ một luồng của file đang chọn: VIDEO / AUDIO (GIỮ – XOÁ, gạch ngang khi xoá) / SUB trong MKV / phụ đề NGOÀI / audio ghép -->
    <DataTemplate x:Key="StreamCardTemplate">
      <Border x:Name="Card" Margin="0,0,0,6" Padding="10,7" CornerRadius="6" BorderThickness="1"
              Background="{Binding Kind, Converter={x:Static l:KindBrushConverter.Soft}}"
              BorderBrush="{Binding Kind, Converter={x:Static l:KindBrushConverter.Soft}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Margin="0,0,10,0" Padding="7,2" CornerRadius="4" VerticalAlignment="Center" BorderThickness="1"
                  Background="{Binding BadgeKind, Converter={x:Static l:KindBrushConverter.Soft}}"
                  BorderBrush="{Binding BadgeKind, Converter={x:Static l:KindBrushConverter.Accent}}">
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Text="{Binding Badge}"
                       Foreground="{Binding BadgeKind, Converter={x:Static l:KindBrushConverter.Accent}}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                       TextDecorations="{Binding Drop, Converter={x:Static l:StrikeConverter.Instance}}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock FontSize="11.5" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LogDimBrush}"
                       Visibility="{Binding Detail, Converter={x:Static l:EmptyToCollapsedConverter.Instance}}" />
          </StackPanel>
          <Border Grid.Column="2" Margin="8,0" Padding="7,2" CornerRadius="4" VerticalAlignment="Center" Background="{StaticResource AmberAccentBrush}"
                  Visibility="{Binding DefaultText, Converter={x:Static l:EmptyToCollapsedConverter.Instance}}">
            <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BadgeTextBrush}" Text="{Binding DefaultText}" />
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Padding="8,2" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                    Background="{Binding StateKind, Converter={x:Static l:KindBrushConverter.Soft}}"
                    BorderBrush="{Binding StateKind, Converter={x:Static l:KindBrushConverter.Accent}}">
              <TextBlock FontSize="11.5" FontWeight="Bold" Text="{Binding StateText}"
                         Foreground="{Binding StateKind, Converter={x:Static l:KindBrushConverter.Accent}}" />
            </Border>
            <CheckBox Margin="10,0,0,0" MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding Drop, Mode=TwoWay}"
                      Visibility="{Binding ToggleVisibility}" Content="{Binding DropLabel}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 1. database đặt tên: BẮT BUỘC chọn mỗi lần, KHÔNG chọn sẵn -->
    <ui:Card Grid.Row="0" Padding="14,10" Margin="0,0,0,10">
      <StackPanel>
        <DockPanel Margin="0,0,0,8" LastChildFill="True">
          <ui:Button x:Name="DbCheckBtn" DockPanel.Dock="Right" Icon="{ui:SymbolIcon PlugConnected24}" Content="{l:Tr 'Kiểm tra lại'}" Click="DbCheck_Click" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource EmeraldAccentBrush}">
              <TextBlock Style="{StaticResource BadgeText}" Text="STEP 03 · AUDIO &amp; SUBTITLE FILTER" />
            </Border>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr '③ Mux'}" />
          </StackPanel>
        </DockPanel>
        <WrapPanel x:Name="DbPanel" Orientation="Horizontal">
          <TextBlock Margin="0,0,10,8" VerticalAlignment="Center" FontWeight="Bold" Text="{l:Tr 'Đặt tên theo (bắt buộc chọn):'}" />
        </WrapPanel>
      </StackPanel>
    </ui:Card>

    <!-- các bước + nút phụ -->
    <ui:Card Grid.Row="1" Padding="12,6" Margin="0,0,0,10">
      <StackPanel>
        <WrapPanel x:Name="StepsPanel" Orientation="Horizontal" />
        <DockPanel Margin="0,4,0,0" LastChildFill="True">
          <ui:Button x:Name="CmdBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Icon="{ui:SymbolIcon Code24}" Content="{l:Tr 'Xem lệnh'}" Click="Cmd_Click" />
          <ui:Button x:Name="KeepAllBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Content="{l:Tr 'Giữ mọi audio tiếng Anh (mọi file)'}" Click="KeepAllEn_Click" />
          <ui:Button x:Name="ResetBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Content="{l:Tr '↺ Làm lại từ đầu'}" Click="Reset_Click"
                     ToolTip="{l:Tr 'Mux xong một lượt: xoá mọi bảng, tổng kết và tiến độ của lượt này (kể cả lựa chọn TMDB / TVDB) để làm lô file mới. KHÔNG xoá file nào; &quot;Hoàn tác…&quot; vẫn dùng được.'}" />
          <WrapPanel x:Name="Hint" Orientation="Horizontal" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </ui:Card>

    <!-- bảng tổng quan + file đang chọn (luồng / bảng phụ đề / audio ghép / chi tiết) + output & lệnh -->
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="38*" MinHeight="110" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="62*" MinHeight="200" />
      </Grid.RowDefinitions>
      <DataGrid x:Name="PlanGrid" Grid.Row="0" Style="{StaticResource WbGrid}" />
      <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" />
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="420" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="430" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <TabControl x:Name="Inner" Grid.Column="0">
          <TabItem x:Name="TabAudio">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock x:Name="AudioTitle" Style="{StaticResource Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <ui:Button x:Name="ApplyAudioBtn" Margin="0,0,6,0" Appearance="Primary" Content="{l:Tr 'Áp dụng lựa chọn audio'}" Click="ApplyAudio_Click" />
                  <ui:Button x:Name="KeepBothBtn" Margin="0,0,10,0" Content="{l:Tr 'Giữ cả hai, Default = bitrate cao nhất'}" Click="KeepBoth_Click" />
                  <CheckBox x:Name="ApplyRest" VerticalAlignment="Center" IsChecked="True" Content="{l:Tr 'Áp dụng cho mọi file còn lại'}" />
                </WrapPanel>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="StreamList" ItemTemplate="{StaticResource StreamCardTemplate}" />
              </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem x:Name="TabGrid">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,6" LastChildFill="True">
                <ui:Button x:Name="GridApplyBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Appearance="Primary" Content="{l:Tr 'Áp dụng bảng chọn'}" Click="GridApply_Click" />
                <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{l:Tr 'Bỏ tick tất cả'}" Click="GridNone_Click" />
                <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{l:Tr 'Tick tất cả'}" Click="GridAll_Click" />
                <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{l:Tr 'Trả về mặc định'}" Click="GridReset_Click" />
                <TextBlock x:Name="GridNote" Style="{StaticResource Body}" />
              </DockPanel>
              <Border x:Name="GridHost" Grid.Row="1" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource GridLineBrush}" />
            </Grid>
          </TabItem>
          <TabItem x:Name="TabDonor">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="DonorHint" Style="{StaticResource Hint}" Margin="2,0,0,6" />
              <DataGrid x:Name="DonorGrid" Grid.Row="1" Style="{StaticResource WbGrid}" />
            </Grid>
          </TabItem>
          <TabItem x:Name="TabInfo">
            <TextBox x:Name="Info" Margin="0,8,0,0" Style="{StaticResource ConsoleBox}" />
          </TabItem>
        </TabControl>
        <GridSplitter Grid.Column="1" Width="6" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />

        <!-- Output & lệnh mkvmerge của file đang chọn (lệnh THẬT — dựng như "Xem lệnh", không ghi gì) -->
        <ui:Card Grid.Column="2" Padding="14,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True">
              <ui:Button x:Name="RunBtn" DockPanel.Dock="Right" Appearance="Success" Icon="{ui:SymbolIcon Play24}" Click="Run_Click">
                <TextBlock x:Name="RunText" />
              </ui:Button>
              <TextBlock Style="{StaticResource CardTitle}" Text="Output &amp; mkvmerge" />
            </DockPanel>
            <TextBlock Grid.Row="1" Margin="0,10,0,4" Style="{StaticResource MonoLabel}" Text="{l:Tr '→ Tên mới (trong Output)'}" />
            <TextBox x:Name="OutPath" Grid.Row="2" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
            <DockPanel Grid.Row="3" Margin="0,10,0,4" LastChildFill="True">
              <TextBlock x:Name="MkvVer" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource EmeraldAccentBrush}" />
              <TextBlock Style="{StaticResource MonoLabel}" Text="CLI COMMAND" />
            </DockPanel>
            <TextBox x:Name="Cli" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource MonoFont}" FontSize="11.5" Padding="10,8" BorderThickness="1" MinHeight="80"
                     Background="{StaticResource PanelDarkBrush}" Foreground="{StaticResource EmeraldAccentBrush}" BorderBrush="#1E293B" />
            <StackPanel Grid.Row="5" Margin="0,10,0,0">
              <DockPanel LastChildFill="True">
                <TextBlock x:Name="RunPct" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{DynamicResource ProgressGreenBrush}" />
                <TextBlock x:Name="RunState" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </DockPanel>
              <ProgressBar x:Name="RunBar" Height="8" Margin="0,6,0,0" Minimum="0" Maximum="1" Foreground="{DynamicResource ProgressGreenBrush}" />
            </StackPanel>
          </Grid>
        </ui:Card>
      </Grid>
    </Grid>

    <TextBlock x:Name="Summary" Grid.Row="3" Margin="2,8,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" />
  </Grid>
</UserControl>
