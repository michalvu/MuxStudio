<UserControl x:Class="MuxStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:MuxStudio.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:Card Grid.Row="0" Padding="14,10" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource RoseAccentBrush}">
            <TextBlock Style="{StaticResource BadgeText}" Foreground="White" Text="SYSTEM CONFIGURATION" />
          </Border>
          <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr 'Cài đặt'}" />
        </StackPanel>
        <WrapPanel x:Name="GroupPanel" Orientation="Horizontal">
          <CheckBox x:Name="Adv" Margin="10,0,0,4" VerticalAlignment="Center" Content="{l:Tr 'Hiện mục nâng cao'}" Click="Adv_Click" />
        </WrapPanel>
      </StackPanel>
    </ui:Card>

    <ui:Card Grid.Row="1" Padding="4" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,6">
        <ContentControl x:Name="Body" />
      </ScrollViewer>
    </ui:Card>

    <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
      <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon FolderOpen24}" Content="{l:Tr 'Mở thư mục cấu hình'}" Click="OpenConfigDir_Click" />
      <ui:Button DockPanel.Dock="Left" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="{l:Tr 'Lưu cài đặt'}" Click="Save_Click" />
      <ui:Button DockPanel.Dock="Left" Margin="6,0,0,0" Content="{l:Tr 'Bỏ thay đổi'}" Click="Reload_Click" />
      <ui:Button DockPanel.Dock="Left" Margin="6,0,0,0" Icon="{ui:SymbolIcon DocumentArrowLeft24}" Content="{l:Tr 'Nhập từ .bat…'}" Click="ImportBat_Click" />
      <ui:Button DockPanel.Dock="Left" Margin="6,0,0,0" Content="{l:Tr 'Khôi phục mặc định…'}" Click="Restore_Click" />
      <TextBlock x:Name="Msg" Margin="12,0,0,0" Style="{StaticResource Body}" TextWrapping="NoWrap" />
    </DockPanel>
  </Grid>
</UserControl>
